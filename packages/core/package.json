{
  "name": "@mattgrill/nearline-core",
  "private": true,
  "version": "1.1.0",
  "description": "Core algorithms for near-duplicate string detection (MinHash + LSH)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && rspack build -c rspack.config.mjs && tsc --emitDeclarationOnly --outDir dist",
    "lint": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/matthewgrill/duplicate-finder.git",
    "directory": "packages/core"
  },
  "author": "Matthew Grill",
  "license": "MIT",
  "keywords": [
    "duplicate",
    "deduplication",
    "minhash",
    "lsh",
    "similarity"
  ]
}
